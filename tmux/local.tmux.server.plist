<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Start a session-less tmux server at login so tmux-continuum restores
       the last saved sessions. exit-empty off keeps the server alive until
       the restore creates sessions. -->
  <key>Label</key>
  <string>local.tmux.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/tmux</string>
    <string>start-server</string>
    <string>;</string>
    <string>set-option</string>
    <string>-g</string>
    <string>exit-empty</string>
    <string>off</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
    <key>SHELL</key>
    <string>/bin/zsh</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/tmux-server.launchd.log</string>
</dict>
</plist>
